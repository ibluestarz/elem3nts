// Worker ELEM3NTS : API /api/* et fichiers statiques Vite sur une seule origine, un Durable Object SQLite par room
// (ARCHITECTURE « Hébergement », DECISIONS D20 et D35). Aucun secret ni variable ici : les secrets passent par
// `wrangler secret` ou `.dev.vars` (ignoré par git). Racine = production (`elem3nts`) ; `env.staging` = Worker distinct,
// donc Durable Objects et stockage distincts (PFC-022, D48). L'environnement se choisit au build (`CLOUDFLARE_ENV`) :
// `dist/elem3nts/wrangler.json` est propre à sa cible et `npm run deploy:*` refuse un artefact d'une autre cible.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elem3nts",
  "main": "src/worker/index.ts",
  // Production : https://elem3nts.bluestarz.workers.dev (PFC-023, D50). Pas d'URL par version : seule l'adresse publique
  // sert le jeu (une version non promue resterait joignable).
  "workers_dev": true,
  "preview_urls": false,
  // Date du runtime workerd fourni par wrangler 4.143.0 : ne jamais la dépasser.
  "compatibility_date": "2026-09-26",
  // Aucune télémétrie wrangler depuis les gates locaux ou la CI.
  "send_metrics": false,
  "assets": {
    // Chemin rechargé côté front (ex. /salle/CODE) : index.html, pour les navigations uniquement.
    "not_found_handling": "single-page-application",
    // L'API passe avant les fichiers et le repli SPA : une route inconnue répond JSON 404, jamais index.html.
    "run_worker_first": ["/api", "/api/*"]
  },
  "durable_objects": {
    // LIMITER : un objet par clé d'IP, limites de débit create/join et sockets (PFC-020, D45).
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LIMITER", "class_name": "Limiter" }
    ]
  },
  // Migrations append-only : ne jamais modifier ni supprimer une étape déjà déployée.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Limiter"] }
  ],
  // Workers Logs : journaux structurés du Worker (log.ts), tous conservés (docs/RUNBOOK.md pour les quotas).
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    // https://elem3nts-staging.bluestarz.workers.dev. Clés non héritées par un environnement (liaisons, migrations)
    // répétées à l'identique ; un test vérifie qu'elles ne divergent jamais de la production.
    "staging": {
      "name": "elem3nts-staging",
      "workers_dev": true,
      // Pas d'URL par version : seule l'adresse staging sert le jeu (une version non promue resterait joignable).
      "preview_urls": false,
      "durable_objects": {
        "bindings": [
          { "name": "ROOMS", "class_name": "Room" },
          { "name": "LIMITER", "class_name": "Limiter" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Room"] },
        { "tag": "v2", "new_sqlite_classes": ["Limiter"] }
      ],
      "observability": { "enabled": true, "head_sampling_rate": 1 }
    }
  }
}
